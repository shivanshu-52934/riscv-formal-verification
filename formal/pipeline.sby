[options]
mode prove
depth 20

[engines]
smtbmc yices

[script]
read -formal pc.sv
read -formal imem.sv
read -formal decoder.sv
read -formal control_unit.sv
read -formal regfile.sv
read -formal alu.sv
read -formal if_id_reg.sv
read -formal id_ex_reg.sv
read -formal ex_wb_reg.sv
read -formal hazard_unit.sv
read -formal stall_controller.sv
read -formal cpu_pipeline.sv

read -formal pipeline_formal.sv

prep -top pipeline_formal

